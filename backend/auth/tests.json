{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Register new player",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "game": "CR", "tag": "#TESTUSER1", "name": "TestPlayer"},
      "expectedStatus": 200,
      "expectedBody": {"name": "TestPlayer"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login existing player",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "game": "CR", "tag": "#TESTUSER1"},
      "expectedStatus": 200,
      "expectedBody": {"name": "TestPlayer"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login unknown player",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "game": "BS", "tag": "#NOTEXIST99"},
      "expectedStatus": 404
    }
  ]
}
